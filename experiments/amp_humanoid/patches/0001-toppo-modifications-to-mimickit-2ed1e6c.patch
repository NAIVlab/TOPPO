+    def get_eval_metrics(self):
+        char_id = self._get_char_id()
+        root_pos = self._engine.get_root_pos(char_id)
+        root_rot = self._engine.get_root_rot(char_id)
+        delta_root_pos = root_pos - self._prev_root_pos
+        root_vel = delta_root_pos / self._engine.get_timestep()
+
+        target_velocity = self._tar_speed.unsqueeze(-1) * self._tar_dir
+        target_velocity_error = torch.linalg.vector_norm(
+            target_velocity - root_vel[..., 0:2], dim=-1
+        )
+        projected_speed = torch.sum(self._tar_dir * root_vel[..., 0:2], dim=-1)
