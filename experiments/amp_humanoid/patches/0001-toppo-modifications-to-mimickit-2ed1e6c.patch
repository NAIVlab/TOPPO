+        facing_dir = torch_util.quat_rotate(heading_rot, facing_dir)
+        facing_alignment = torch.sum(self._face_dir * facing_dir[..., 0:2], dim=-1)
+
+        up_dir = torch.zeros_like(root_pos)
+        up_dir[..., 2] = 1.0
+        root_up = torch_util.quat_rotate(root_rot, up_dir)
+
+        metrics = {
+            "target_velocity_error": target_velocity_error,
+            "target_speed_error": torch.abs(self._tar_speed - projected_speed),
